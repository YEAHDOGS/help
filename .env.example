# ── Dogs Help — environment variables ─────────────────────────────
# Copy to .env.local and fill in as you set up each service.
# Every variable is OPTIONAL: the app runs with none of them, and each
# feature turns on as its keys are added (see /api/health).

# Clerk — auth (dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — backend / Postgres (supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — payments (dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — emails (resend.com/api-keys)
RESEND_API_KEY=
# Optional custom sender, e.g. "Dogs Help <hello@yourdomain.com>"
RESEND_FROM=

# PostHog — analytics (app.posthog.com → Project Settings)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — error tracking (sentry.io → Project Settings → Client Keys)
NEXT_PUBLIC_SENTRY_DSN=

# Upstash — Redis rate limiting (console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pinecone — vector DB / semantic search (app.pinecone.io)
PINECONE_API_KEY=
PINECONE_INDEX=dogs-help
